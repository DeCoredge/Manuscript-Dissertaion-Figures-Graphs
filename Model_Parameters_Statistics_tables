#Clear current working environment
rm(list = ls())

#Instal package that allows you to make tables
install.packages("gt")
install.packages("grid")
install.packages("gridExtra")

library(grid)
library(gridExtra)

# Use data from csv file to create tables
mifish_stats_table <- read.csv("MiFish_Model_Parameters_Statistics.csv", header = TRUE, sep = ",")

# Define custom table theme
table_theme <- ttheme_default( core = list(fg_params = list(col = "black")), 
  colhead = list(fg_params = list(col = "black")))

# Create table grob with the custom theme applied
mifish_parameters <- tableGrob(mifish_stats_table, theme = table_theme)

# Create the title object
table_title <- textGrob("MiFish Model Parameters & Statistics",               # Your title text
  gp = gpar(fontsize = 16, fontface = "bold", col = "black") )# Title styling

# View the final table

grid.newpage()
grid.draw(mifish_parameters)


